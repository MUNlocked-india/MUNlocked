# Copy this file to .env.local and fill in values from your own Supabase project
# (Project Settings -> API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used server-side (e.g. for admin scripts). Never expose this in the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — powers the /api/chat route. Get this from console.anthropic.com.
# Never prefix this with NEXT_PUBLIC_, or it will be sent to every browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only — powers email notifications (conference/EB approval & rejection).
# Get this from resend.com (free tier is enough to start). Never prefix with
# NEXT_PUBLIC_.
RESEND_API_KEY=your-resend-api-key
